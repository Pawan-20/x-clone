# Regex: starts with [label]: or [label] :
PATTERN='^\[[^\]]+\]([ ]*:[ ]*|[ ]*:[^ ]*).+'

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

if ! echo "$commit_msg" | grep -Eq "$PATTERN"; then
  echo "\n❌ Invalid commit message format."
  echo "✅ Expected format: [label]: your message"
  echo "💡 Example: [fix]: fix crash on load"
  exit 1
fi
